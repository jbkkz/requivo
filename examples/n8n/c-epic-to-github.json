      "parameters": {},
      "name": "Skip: issues already exist",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2640,
        -240
      ],
      "notes": "An earlier run created these issues: skip, or update them by hand. Never duplicate.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const gh = (method, path, body) => this.helpers.httpRequest({ method, json: true, body,\n  url: 'https://api.github.com/repos/' + $env.GITHUB_REPOSITORY + path,\n  headers: { Authorization: 'Bearer ' + $env.GITHUB_TOKEN, Accept: 'application/vnd.github+json', 'User-Agent': 'requivo-n8n-example' } });\nconst { plan, openQuestions, sourceRevision } = $input.first().json;\nconst names = [...new Set([plan.tracking_issue.milestone, ...plan.issues.map((i) => i.milestone)].filter(Boolean))];\nconst existing = await gh('GET', '/milestones?state=all&per_page=100');\nconst numbers = {};\nfor (const name of names) {\n  const hit = existing.find((m) => m.title === name);\n  numbers[name] = hit ? hit.number : (await gh('POST', '/milestones', { title: name })).number;  // creating is this example's policy\n}\nreturn [{ json: { plan, openQuestions, sourceRevision, numbers } }];"
      },
      "name": "GitHub: resolve milestone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const gh = (method, path, body) => this.helpers.httpRequest({ method, json: true, body,\n  url: 'https://api.github.com/repos/' + $env.GITHUB_REPOSITORY + path,\n  headers: { Authorization: 'Bearer ' + $env.GITHUB_TOKEN, Accept: 'application/vnd.github+json', 'User-Agent': 'requivo-n8n-example' } });\nconst { plan, openQuestions, sourceRevision, numbers } = $input.first().json;\nconst created = {};  // ref -> issue number; children first, in envelope order\nfor (const issue of plan.issues) {\n  const body = { title: issue.title, body: issue.body, labels: issue.labels };\n  if (issue.milestone) body.milestone = numbers[issue.milestone];\n  created[issue.ref] = (await gh('POST', '/issues', body)).number;\n}\nreturn [{ json: { plan, openQuestions, sourceRevision, numbers, created } }];"
      },
      "name": "GitHub: create issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const gh = (method, path, body) => this.helpers.httpRequest({ method, json: true, body,\n  url: 'https://api.github.com/repos/' + $env.GITHUB_REPOSITORY + path,\n  headers: { Authorization: 'Bearer ' + $env.GITHUB_TOKEN, Accept: 'application/vnd.github+json', 'User-Agent': 'requivo-n8n-example' } });\nconst { plan, openQuestions, sourceRevision, numbers, created } = $input.first().json;\nconst t = plan.tracking_issue;\nconst body = { title: t.title, body: t.body + '\\n\\n_Exported from model revision ' + sourceRevision + '._', labels: t.labels };\nif (t.milestone) body.milestone = numbers[t.milestone];\nconst tracking = await gh('POST', '/issues', body);\nreturn [{ json: { url: tracking.html_url, count: Object.keys(created).length, openQuestions } }];"
      },
      "name": "GitHub: create tracking issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
