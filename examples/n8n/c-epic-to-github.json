    {
      "parameters": {
        "jsCode": "const plan = $('Plan from file').first().json.plan;\nconst envelope = $input.first().json.envelope;\nconst epicRevision = ($('Parse status (after)').isExecuted ? $('Parse status (after)') : $('Parse status (before)')).first().json.epicRevision;\nif (envelope.format !== 'requivo-epic' || envelope.version !== 2) throw new Error('unexpected export format/version');\n// source_revision identifies the basis the export was rendered from; staleness was already judged by the flag above.\nif (plan.source_revision !== epicRevision) throw new Error('export source_revision ' + plan.source_revision + ' is not the tracked epic revision ' + epicRevision);\nreturn [{ json: { plan, openQuestions: envelope.open_questions || [], sourceRevision: plan.source_revision } }];"
      },
      "name": "Check provenance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const gh = (method, path, body) => this.helpers.httpRequest({ method, json: true, body,\n  url: 'https://api.github.com/repos/' + $env.GITHUB_REPOSITORY + path,\n  headers: { Authorization: 'Bearer ' + $env.GITHUB_TOKEN, Accept: 'application/vnd.github+json', 'User-Agent': 'requivo-n8n-example' } });\nconst { plan, openQuestions, sourceRevision } = $input.first().json;\nconst found = await gh('GET', '/issues?state=all&per_page=1&labels=' + encodeURIComponent(plan.idempotency_label));\nreturn [{ json: { plan, openQuestions, sourceRevision, alreadyCreated: found.length > 0 } }];"
      },
      "name": "GitHub: idempotency search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
