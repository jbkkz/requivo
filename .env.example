# Copy this file to .env and fill in your key. .env is gitignored — never commit a real key.
#
# The ANTHROPIC_API_KEY is only needed for the API-powered CLI mode
# (`pip install 'requivo[anthropic]'`, then `requivo discover …`). It is NOT required to use Requivo
# inside Claude Code — there, Claude does the reasoning and the deterministic CLI applies it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5-5 when unset.
REQUIVO_MODEL=claude-sonnet-5-5
