{
  "repo": "jbkkz/requivo",
  "default_branch": "main",
  "branch_pattern": "fix/{issue}",
  "test_command": "uv run --extra dev pytest tests/ -q -rs",
  "version_sites": [
    "pyproject.toml",
    "src/requivo/__init__.py",
    "CHANGELOG.md",
    "plugins/claude-code/.claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json"
  ],
  "changelog_dir": "changelog.d",
  "changelog_untagged": [
    "0.6.1"
  ],
  "docs_targets": [
    "README.md"
  ],
  "labels": {
    "filed_by_loop": "filed-by-loop",
    "priority": [
      "priority-blocker",
      "priority-high",
      "priority-low"
    ],
    "lanes": [
      "lane-core",
      "lane-services",
      "lane-providers",
      "lane-surfaces",
      "lane-tests",
      "lane-infra",
      "lane-plugin"
    ]
  },
  "milestones": [],
  "release": {
    "authority": "loop",
    "tag_pattern": "v{version}",
    "merge_method": "squash",
    "commit_subject": null,
    "create_release": true,
    "draft": false,
    "latest": true
  }
}
